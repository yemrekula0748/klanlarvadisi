###############################################################################
# KLANLAR VADİSİ — Sunucu Yapılandırması
# Unity istemcisi bu sunucunun /api/v1 uçlarına bağlanır.
###############################################################################

APP_NAME="Klanlar Vadisi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#------------------------------------------------------------------------------
# Veritabanı — MySQL 8.0+
#------------------------------------------------------------------------------
# Varsayılan: SQLite — ayrı bir veritabanı sunucusu kurmak gerekmez.
# `kur.sh` dosyayı kendisi oluşturur.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# MySQL kullanacaksanız yukarıdaki iki satırı silip aşağıdakileri açın
# (ya da `./kur.sh --mysql` çalıştırın):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=klanlar_vadisi
# DB_USERNAME=root
# DB_PASSWORD=

#------------------------------------------------------------------------------
# Oturum / Önbellek / Kuyruk
#------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

#------------------------------------------------------------------------------
# Gerçek zamanlı (Laravel Reverb) — Unity WebSocket ile bağlanır
#------------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=klanlar
REVERB_APP_KEY=klanlar-vadisi-anahtari
REVERB_APP_SECRET=klanlar-vadisi-gizli-anahtar
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

#------------------------------------------------------------------------------
# Oyun ayarları
#------------------------------------------------------------------------------
# Dünya tohumu: istemci ve sunucu aynı araziyi üretir. DEĞİŞTİRİLİRSE
# mevcut haritadaki obaların arazisi değişir — üretimde sabit tutun.
GAME_WORLD_SEED=20261071
GAME_WORLD_WIDTH=1600
GAME_WORLD_HEIGHT=1600

# Unity istemcisinin bağlanmasına izin verilen kaynaklar (CORS).
# Editörde çalışırken * bırakılabilir; üretimde kendi alan adınızı yazın.
GAME_ALLOWED_ORIGINS=*

MAIL_MAILER=log
MAIL_FROM_ADDRESS="oyun@klanlarvadisi.test"
MAIL_FROM_NAME="${APP_NAME}"

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
